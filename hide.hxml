hide_common.hxml
-lib hxnodejs
-D js-classic
-D js-unflatten
-D editor
-D multidriver
-cp hide_js
-cp hide_js/libs

-js bin/hide.js
-main hide.Ide
--macro hide.tools.Macros.includeShaderSources()
cdb.ConstLoader

#-D shader_debug_dump

--next

# Electron main process
-cp hide_js
-cp hide_js/libs
-lib hxnodejs
-main hide.ElectronMain
-js bin/main.js
-dce full
-D js-es=6
-debug
