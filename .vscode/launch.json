{
    // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
    // Pointez pour afficher la description des attributs existants.
    // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // Electron main process (ElectronMain.hx), used by the "Launch" compounds below
        {
            "type": "node",
            "request": "launch",
            "name": "HIDE main process",
            "cwd": "${workspaceFolder}/bin",
            "runtimeExecutable": "${workspaceFolder}/bin/electron/electron.exe",
            "args": [".", "--remote-debugging-port=9222"],
            "env": {"HIDE_DEBUG":"1", "ELECTRON_RUN_AS_NODE": null},
            "outputCapture": "std",
            "sourceMaps": true,
            "presentation": { "hidden": true }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "CDB main process",
            "cwd": "${workspaceFolder}/bin",
            "runtimeExecutable": "${workspaceFolder}/bin/electron/electron.exe",
            "args": [".", "--remote-debugging-port=9222", "--cdb"],
            "env": {"HIDE_DEBUG":"1", "ELECTRON_RUN_AS_NODE": null},
            "outputCapture": "std",
            "sourceMaps": true,
            "presentation": { "hidden": true }
        },
        // Editor (hide.js), waits for the window started by the main process
        {
            "type": "chrome",
            "request": "attach",
            "name": "HIDE editor",
            "address": "127.0.0.1",
            "port": 9222,
            "timeout": 60000,
            "urlFilter": "*app.html",
            "sourceMaps": true,
            "webRoot": "${workspaceFolder}/bin",
            "presentation": { "hidden": true }
        },
        // Attach to an already running HIDE (started with hide.cmd)
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to HIDE",
            "address": "127.0.0.1",
            "port": 9222,
            "urlFilter": "*app.html",
            "sourceMaps": true,
            "webRoot": "${workspaceFolder}/bin",
            "preLaunchTask": "Build hide",
            "presentation": { "group": "1_hide", "order": 3 }
        },
        {
            "name": "hide_hl",
            "request": "launch",
            "type": "hl",
            "cwd": "${workspaceFolder}",
			"port": 7779,
            "preLaunchTask": "Build hide_hl",
            "presentation": { "group": "2_hl", "order": 1 }
        },
        {
            "name": "hide_hl --autoprofile",
            "request": "launch",
            "type": "hl",
            "cwd": "${workspaceFolder}",
			"args": ["--autoprofile"],
			"port": 7779,
            "preLaunchTask": "Build hide_hl",
            "presentation": { "group": "2_hl", "order": 2 }
        }
    ],
    // build first, then start Electron and debug both the main process and the editor
    "compounds": [
        {
            "name": "Launch HIDE",
            "configurations": ["HIDE main process", "HIDE editor"],
            "preLaunchTask": "Build hide",
            "stopAll": true,
            "presentation": { "group": "1_hide", "order": 1 }
        },
        {
            "name": "Launch CDB",
            "configurations": ["CDB main process", "HIDE editor"],
            "preLaunchTask": "Build hide",
            "stopAll": true,
            "presentation": { "group": "1_hide", "order": 2 }
        }
    ]
}
