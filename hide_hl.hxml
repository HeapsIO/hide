hide_common.hxml
-lib hlphysics
# -D editor # Disabled at the moment because most of the #if editor code of hide depends on js and we don't have it in the hl target

-D hui
-D dx12
-D hl-profile

-D editor_hl
-D heaps_debug_events
-D dx12_shader_debug
# -D renderdoc
# -D prefab_ignore_get_editor_props

-D cdb_datafiles
-cp hide_hl
-hl bin_hl/hide.hl
-lib hldx
#-lib hlsdl
-xml hide_hl/api.xml
-main hide.App
--macro hide.HlMacros.init()
--macro include("hide.ui.comp")
--macro include("hide.ui")
--macro include("hrt.ui")

-D hl_ver=2.0.0

# hack so hxd.Res doesn't create conflicting packages when building hrt.ui.HuiRes
-D resourcesPath=hide_hl/emptyres